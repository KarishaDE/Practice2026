<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CommandLib\CommandLib.csproj" />
    <ProjectReference Include="..\FileSystemCommands\FileSystemCommands.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="CopyCommandsLibrary" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../FileSystemCommands/bin/$(Configuration)/$(TargetFramework)/FileSystemCommands.dll"
          DestinationFolder="$(OutDir)" />
  </Target>

</Project>
